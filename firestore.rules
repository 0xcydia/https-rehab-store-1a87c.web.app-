rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /products/{id} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email.matches('.*@rehabstore\\.com$');
    }
    match /orders/{id} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.uid || request.auth.token.email.matches('.*@rehabstore\\.com$'));
      allow create: if true;
      allow update: if request.auth != null && request.auth.token.email.matches('.*@rehabstore\\.com$');
      allow delete: if false;
    }
    match /subscribers/{id} {
      allow read: if request.auth != null && request.auth.token.email.matches('.*@rehabstore\\.com$');
      allow create: if true;
      allow write, delete: if false;
    }
  }
}
